<?xml version="1.0"?>
<ruleset name="Wille GEO">
	<description>WordPress-Extra (security, DB, i18n, formatting), WordPress VIP security sniffs and PHPCompatibility. No baseline, warnings fail the build, and inline phpcs:ignore/disable comments have no effect (scripts/phpcs-strict.mjs runs with --ignore-annotations). The only exceptions live in this file, scoped and explained.</description>

	<file>wille-geo-ai-visibility</file>
	<file>tests</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Generated by scripts/i18n.mjs. -->
	<exclude-pattern>wille-geo-ai-visibility/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Windows checkouts may have CRLF; Git normalises on commit (.gitattributes). -->
	<rule ref="Internal.LineEndings.Mixed">
		<severity>0</severity>
	</rule>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The full WordPress standard: Core + Docs + Extra. -->
	<rule ref="WordPress"/>
	<rule ref="Squiz.PHP.CommentedOutCode">
		<properties>
			<property name="maxPercentage" value="35"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wille-geo-ai-visibility"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="geoins"/>
				<element value="GEOINS"/>
			</property>
		</properties>
	</rule>

	<!-- Security/correctness sniffs from WordPress VIP. -->
	<rule ref="WordPressVIPMinimum.Security"/>
	<rule ref="WordPressVIPMinimum.Hooks.AlwaysReturnInFilter"/>
	<rule ref="WordPressVIPMinimum.Functions.CheckReturnValue"/>
	<rule ref="WordPressVIPMinimum.Functions.DynamicCalls"/>
	<rule ref="WordPressVIPMinimum.Functions.StripTags"/>
	<rule ref="WordPressVIPMinimum.Classes.DeclarationCompatibility"/>
	<rule ref="WordPressVIPMinimum.Files.IncludingNonPHPFile"/>

	<!-- Tests run outside WordPress with Brain Monkey: no prefixes, escaping or i18n there. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- PSR-4 test classes (tests/unit/BotsTest.php) instead of class-bots-test.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Test harness and the WordPress stubs re-implement WP functions with PHP natives and set up tables directly. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Functions.StripTags">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>tests/stubs/*</exclude-pattern>
	</rule>

	<!-- Docblocks are required for the plugin; test methods and stubs document themselves through their names. -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- PHP's own DOM API (ext/dom) uses camelCase property names; they cannot be renamed. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="childNodes"/>
				<element value="nodeName"/>
				<element value="parentNode"/>
				<element value="textContent"/>
			</property>
		</properties>
	</rule>
</ruleset>
