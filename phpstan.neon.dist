# PHPStan for the plugin (composer phpstan). No baseline: new findings fail the build.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 8
    # Header promises PHP 7.4; check the whole supported range.
    phpVersion:
        min: 70400
        max: 80599
    tmpDir: .cache/phpstan
    paths:
        - geo-insights-ai
    # WP-CLI is not a Composer dependency of the plugin; the commands (class-geoins-cli.php) only need the stubs.
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    excludePaths:
        - geo-insights-ai/languages/*
