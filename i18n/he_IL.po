msgstr "חסימה בטוחה מבחינת ציטוטים"

msgid "by %s"
msgstr "מאת %s"

msgid "days"
msgstr "ימים"

msgid "e.g. WordPress backup plugin"
msgstr "לדוגמה: תוסף גיבוי לוורדפרס"

msgid "forever"
msgstr "לתמיד"

